---
import { business } from "../../data/business";
import { copy } from "../../data/copy";
import SectionLabel from "../layout/SectionLabel.astro";
---

<section class="call-prep section-shell">
  <div class="container section-grid">
    <SectionLabel number="06" label={copy.home.callPrep.metadata} />

    <div class="call-prep__grid">
      <div class="call-prep__copy flow-lg">
        <span class="eyebrow-stack eyebrow">{copy.home.callPrep.metadata}</span>
        <h2>{copy.home.callPrep.title}</h2>
        <p>{copy.home.callPrep.intro}</p>
        <ol class="call-prep__list">
          {copy.home.callPrep.points.map((point, index) => (
            <li>
              <span class="section-number">{String(index + 1).padStart(2, "0")}</span>
              <span>{point}</span>
            </li>
          ))}
        </ol>
      </div>

      <aside class="call-prep__aside">
        <span class="meta-text">Dogovor termina</span>
        <a href={business.phoneUri}>{business.displayPhone}</a>
        <div class="call-prep__actions">
          <a class="button button--primary" href={business.phoneUri}>
            {copy.home.callPrep.primaryCta}
          </a>
          <a class="link-arrow" href="/kontakt/#kontakt-forma">
            {copy.home.callPrep.secondaryCta}
          </a>
        </div>
      </aside>
    </div>
  </div>
</section>

<style>
  .call-prep {
    background: var(--color-paper-light);
  }

  .call-prep__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(280px, 0.7fr);
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: start;
  }

  .call-prep__list {
    display: grid;
    gap: var(--space-3);
  }

  .call-prep__list li {
    display: grid;
    grid-template-columns: 56px 1fr;
    gap: var(--space-3);
    align-items: start;
    padding-bottom: var(--space-3);
    border-bottom: var(--border);
  }

  .call-prep__aside {
    display: grid;
    gap: var(--space-4);
    padding: clamp(1.25rem, 3vw, 2rem);
    border: var(--border-strong);
    background: var(--color-paper);
  }

  .call-prep__aside a[href^="tel"] {
    font-family: var(--font-display);
    font-size: clamp(2rem, 7vw, 4rem);
    line-height: 0.98;
    letter-spacing: -0.04em;
  }

  .call-prep__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    align-items: center;
  }

  @media (max-width: 820px) {
    .call-prep__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
