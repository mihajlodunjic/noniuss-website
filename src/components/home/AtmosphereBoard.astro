---
import { Picture } from "astro:assets";
import horseHead from "../../assets/images/home/horse-head-stable.jpg";
import pasture from "../../assets/images/contact/horse-pasture-atmosphere.jpg";
import ridingLesson from "../../assets/images/school/riding-lesson-beginner.jpg";
import { copy } from "../../data/copy";
import SectionLabel from "../layout/SectionLabel.astro";

const images = [
  {
    src: horseHead,
    alt: "Glava konja mirno proviruje iz štalskog prostora."
  },
  {
    src: ridingLesson,
    alt: "Početnica uz vođenje uči prve pokrete u sedlu na otvorenom."
  },
  {
    src: pasture,
    alt: "Konj stoji u travi na otvorenom pašnjaku."
  }
];
---

<section class="section-shell">
  <div class="container section-grid">
    <SectionLabel number="05" label={copy.home.atmosphere.metadata} />

    <div class="atmosphere">
      <div class="page-title-block">
        <span class="eyebrow-stack eyebrow">{copy.home.atmosphere.metadata}</span>
        <h2>{copy.home.atmosphere.title}</h2>
        <p>{copy.home.atmosphere.intro}</p>
      </div>

      <div class="atmosphere__board">
        {copy.home.atmosphere.notes.map((note, index) => (
          <article class="atmosphere__item">
            <Picture
              src={images[index].src}
              alt={images[index].alt}
              formats={["webp"]}
              widths={[420, 720, 1080]}
              sizes="(max-width: 820px) 100vw, 31vw"
              loading="lazy"
            />
            <div class="flow">
              <h3>{note.title}</h3>
              <p>{note.text}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .atmosphere {
    display: grid;
    gap: clamp(1.75rem, 3vw, 2.5rem);
  }

  .atmosphere__board {
    display: grid;
    grid-template-columns: 1.02fr 0.94fr 1fr;
    gap: clamp(1rem, 2vw, 1.5rem);
    align-items: start;
  }

  .atmosphere__item {
    display: grid;
    gap: 0.9rem;
  }

  .atmosphere__item :global(picture) {
    display: block;
    border: var(--border);
    border-radius: var(--radius-lg);
    background: rgba(220, 224, 212, 0.55);
    overflow: hidden;
  }

  .atmosphere__item :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: var(--image-filter-balanced);
  }

  .atmosphere__item:nth-child(1) :global(img) {
    aspect-ratio: 4 / 4.6;
    object-position: center 30%;
  }

  .atmosphere__item:nth-child(2) :global(img) {
    aspect-ratio: 4 / 4.7;
    object-position: center 48%;
  }

  .atmosphere__item:nth-child(3) :global(img) {
    aspect-ratio: 4 / 4.8;
    object-position: center 62%;
    filter: var(--image-filter-warm);
  }

  .atmosphere__item:nth-child(2) {
    padding-top: clamp(0rem, 1.6vw, 1rem);
  }

  @media (max-width: 900px) {
    .atmosphere__board {
      grid-template-columns: 1fr;
    }

    .atmosphere__item:nth-child(2) {
      padding-top: 0;
    }

    .atmosphere__item :global(img) {
      aspect-ratio: 4 / 3;
    }
  }
</style>
