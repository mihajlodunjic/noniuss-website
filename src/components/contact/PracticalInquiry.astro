---
import { copy } from "../../data/copy";
import SectionLabel from "../layout/SectionLabel.astro";
---

<section class="section-shell">
  <div class="container section-grid">
    <SectionLabel number="02" label="Šta navesti u upitu" />

    <div class="practical-inquiry">
      <div class="page-title-block">
        <span class="eyebrow-stack eyebrow">Priprema poruke</span>
        <h2>{copy.contact.inquiry.title}</h2>
        <p>{copy.contact.inquiry.intro}</p>
      </div>

      <ol class="practical-inquiry__list">
        {copy.contact.inquiry.points.map((point, index) => (
          <li>
            <span class="section-number">{String(index + 1).padStart(2, "0")}</span>
            <span>{point}</span>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  .practical-inquiry {
    display: grid;
    gap: var(--space-6);
  }

  .practical-inquiry__list {
    display: grid;
    gap: var(--space-4);
  }

  .practical-inquiry__list li {
    display: grid;
    grid-template-columns: 72px 1fr;
    gap: var(--space-4);
    align-items: start;
    padding-bottom: var(--space-4);
    border-bottom: var(--border);
  }

  @media (max-width: 560px) {
    .practical-inquiry__list li {
      grid-template-columns: 1fr;
      gap: var(--space-2);
    }
  }
</style>
