---
import { business } from "../../data/business";
import { copy } from "../../data/copy";
import SectionLabel from "../layout/SectionLabel.astro";

const { number = "02" } = Astro.props as { number?: string };
---

<section class="section-shell">
  <div class="container section-grid">
    <SectionLabel number={number} label="Kontakt podaci" />

    <div class="contact-details">
      <div class="page-title-block">
        <span class="eyebrow-stack eyebrow">Direktan kontakt</span>
        <h2>{copy.contact.details.title}</h2>
      </div>

      <dl class="contact-details__grid">
        <div class="contact-details__row">
          <dt>{copy.contact.details.phoneLabel}</dt>
          <dd>
            <a href={business.phoneUri}>{business.displayPhone}</a>
          </dd>
        </div>

        <div class="contact-details__row">
          <dt>{copy.contact.details.emailLabel}</dt>
          <dd>
            <a href={`mailto:${business.email}`}>{business.email}</a>
          </dd>
        </div>

        <div class="contact-details__row">
          <dt>{copy.contact.details.instagramLabel}</dt>
          <dd>
            <a href={business.instagramUrl} target="_blank" rel="noopener noreferrer">
              {business.instagramHandle}
            </a>
          </dd>
        </div>

        <div class="contact-details__row">
          <dt>{copy.contact.details.locationLabel}</dt>
          <dd>{business.address}, {business.postalCode} {business.city}</dd>
        </div>
      </dl>

      <div class="contact-details__actions">
        <a class="button button--primary" href={business.phoneUri}>
          {copy.contact.details.phoneCta}
        </a>
        <a class="link-arrow" href={business.instagramUrl} target="_blank" rel="noopener noreferrer">
          {copy.contact.details.instagramCta}
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .contact-details {
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.4rem);
  }

  .contact-details__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-5);
  }

  .contact-details__row {
    display: grid;
    gap: 0.55rem;
    padding: 1rem 1.05rem;
    border: var(--border);
    border-radius: var(--radius-md);
    background: var(--color-paper-light);
    transition:
      border-color 180ms ease,
      background-color 180ms ease,
      transform 180ms ease;
  }

  .contact-details__row dt {
    font-family: var(--font-meta);
    font-size: var(--meta-size);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #595850;
  }

  .contact-details__row dd {
    font-size: clamp(1.08rem, 1rem + 0.35vw, 1.2rem);
  }

  .contact-details__row dd a {
    font-weight: 600;
  }

  .contact-details__row:has(a:hover),
  .contact-details__row:has(a:focus-visible) {
    background: #f7f3e8;
    border-color: rgba(146, 94, 56, 0.55);
    transform: translateY(-1px);
  }

  .contact-details__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem 1.1rem;
  }

  @media (max-width: 700px) {
    .contact-details__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
