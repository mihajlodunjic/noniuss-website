---
import { business } from "../../data/business";
import SectionLabel from "../layout/SectionLabel.astro";

type Props = {
  number: string;
  label: string;
  title: string;
  text: string;
  address: string;
  primaryCta: string;
  secondaryCta?: string;
  compact?: boolean;
};

const { number, label, title, text, address, primaryCta, secondaryCta, compact = false } =
  Astro.props as Props;
---

<section class="section-shell">
  <div class="container section-grid">
    <SectionLabel number={number} label={label} />

    <div class={`location-panel ${compact ? "location-panel--compact" : ""}`}>
      <div class="location-panel__copy flow-lg">
        <h2>{title}</h2>
        <p>{text}</p>
        <div class="paper-note location-panel__address">
          <span class="meta-text">Adresa</span>
          <strong>{address}</strong>
        </div>
        <div class="location-panel__actions">
          <a class="button button--primary" href={business.mapUrl} target="_blank" rel="noreferrer">
            {primaryCta}
          </a>
          {secondaryCta && <a class="link-arrow" href={business.phoneUri}>{secondaryCta}</a>}
        </div>
      </div>

      <div class="location-panel__map" aria-hidden="true">
        <div class="location-panel__topo">
          <span class="location-panel__stamp meta-text">{business.locationLabel}</span>
          <svg
            class="location-panel__svg"
            viewBox="0 0 640 420"
            xmlns="http://www.w3.org/2000/svg"
            aria-hidden="true"
          >
            {
              Array.from({ length: 6 }).map((_, index) => (
                <line
                  x1={index * 128}
                  y1="0"
                  x2={index * 128}
                  y2="420"
                  stroke="rgba(21,22,18,0.11)"
                  stroke-width="1"
                />
              ))
            }
            {
              Array.from({ length: 5 }).map((_, index) => (
                <line
                  x1="0"
                  y1={index * 96}
                  x2="640"
                  y2={index * 96}
                  stroke="rgba(21,22,18,0.11)"
                  stroke-width="1"
                />
              ))
            }
            <circle cx="494" cy="124" r="144" stroke="rgba(38,56,46,0.24)" stroke-width="1.6" fill="none" />
            <circle cx="164" cy="310" r="88" stroke="rgba(38,56,46,0.2)" stroke-width="1.5" fill="none" />
            <path
              d="M70 354C153 267 204 233 279 225C382 214 461 250 575 184"
              stroke="rgba(21,22,18,0.3)"
              stroke-width="2.2"
              fill="none"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
            <path
              d="M122 120C188 148 242 166 302 166C378 166 448 142 532 92"
              stroke="rgba(38,56,46,0.24)"
              stroke-width="1.8"
              fill="none"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
          <div class="location-panel__tag">Prethodni dogovor</div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .location-panel {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
    gap: clamp(1.25rem, 3vw, 2.5rem);
    align-items: stretch;
  }

  .location-panel__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    align-items: center;
  }

  .location-panel__address {
    display: inline-grid;
    gap: var(--space-2);
    width: fit-content;
  }

  .location-panel__map {
    border: var(--border);
    border-radius: var(--radius-lg);
    background: var(--color-paper-light);
    min-height: 340px;
    overflow: hidden;
  }

  .location-panel__topo {
    position: relative;
    height: 100%;
    background:
      linear-gradient(180deg, rgba(251, 249, 243, 0.98), rgba(243, 239, 228, 0.98)),
      var(--color-paper-light);
  }

  .location-panel__svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .location-panel__stamp {
    position: absolute;
    left: 24px;
    top: 24px;
    color: #4f5148;
  }

  .location-panel__tag {
    position: absolute;
    right: 24px;
    bottom: 24px;
    padding: 0.55rem 0.85rem;
    background: rgba(38, 56, 46, 0.94);
    color: var(--color-white);
    font-family: var(--font-meta);
    font-size: var(--meta-size);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border-radius: var(--radius-sm);
  }

  .location-panel__topo::before {
    content: "Gornje Međurovo · Niš";
    position: absolute;
    left: 24px;
    bottom: 24px;
    z-index: 1;
    font-family: var(--font-display);
    font-size: clamp(1.55rem, 2.3vw, 2.35rem);
    line-height: 1;
    letter-spacing: -0.03em;
    color: rgba(21, 22, 18, 0.9);
  }

  .location-panel--compact .location-panel__map {
    min-height: 300px;
  }

  @media (max-width: 820px) {
    .location-panel {
      grid-template-columns: 1fr;
    }

    .location-panel__map {
      min-height: 280px;
    }
  }
</style>
