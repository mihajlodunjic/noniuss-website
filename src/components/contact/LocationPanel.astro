---
import { business } from "../../data/business";
import SectionLabel from "../layout/SectionLabel.astro";

type Props = {
  number: string;
  label: string;
  title: string;
  text: string;
  address: string;
  primaryCta: string;
  secondaryCta?: string;
  compact?: boolean;
};

const { number, label, title, text, address, primaryCta, secondaryCta, compact = false } =
  Astro.props as Props;
---

<section class="section-shell">
  <div class="container section-grid">
    <SectionLabel number={number} label={label} />

    <div class={`location-panel ${compact ? "location-panel--compact" : ""}`}>
      <div class="location-panel__copy flow-lg">
        <h2>{title}</h2>
        <p>{text}</p>
        <div class="paper-note location-panel__address">
          <span class="meta-text">Adresa</span>
          <strong>{address}</strong>
        </div>
        <div class="location-panel__actions">
          <a class="button button--primary" href={business.mapUrl} target="_blank" rel="noreferrer">
            {primaryCta}
          </a>
          {secondaryCta && <a class="link-arrow" href={business.phoneUri}>{secondaryCta}</a>}
        </div>
      </div>

      <div class="location-panel__map" aria-hidden="true">
        <div class="location-panel__topo">
          <span class="location-panel__stamp meta-text">{business.locationLabel}</span>
          <svg
            class="location-panel__svg"
            viewBox="0 0 640 420"
            xmlns="http://www.w3.org/2000/svg"
            aria-hidden="true"
          >
            {
              Array.from({ length: 11 }).map((_, index) => (
                <line
                  x1={index * 64}
                  y1="0"
                  x2={index * 64}
                  y2="420"
                  stroke="rgba(21,22,18,0.08)"
                  stroke-width="1"
                />
              ))
            }
            {
              Array.from({ length: 8 }).map((_, index) => (
                <line
                  x1="0"
                  y1={index * 60}
                  x2="640"
                  y2={index * 60}
                  stroke="rgba(21,22,18,0.08)"
                  stroke-width="1"
                />
              ))
            }
            <circle cx="490" cy="126" r="148" stroke="rgba(38,56,46,0.18)" stroke-width="1.5" fill="none" />
            <circle cx="166" cy="312" r="92" stroke="rgba(38,56,46,0.18)" stroke-width="1.5" fill="none" />
            <path
              d="M70 354C153 267 204 233 279 225C382 214 461 250 575 184"
              stroke="rgba(21,22,18,0.22)"
              stroke-width="2"
              fill="none"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
          <div class="location-panel__tag">Prethodni dogovor</div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .location-panel {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: stretch;
  }

  .location-panel__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    align-items: center;
  }

  .location-panel__address {
    display: inline-grid;
    gap: var(--space-2);
    width: fit-content;
  }

  .location-panel__map {
    border: var(--border);
    background: var(--color-paper-light);
    min-height: 380px;
    overflow: hidden;
  }

  .location-panel__topo {
    position: relative;
    height: 100%;
    background: var(--color-paper-light);
  }

  .location-panel__svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .location-panel__stamp {
    position: absolute;
    left: 24px;
    top: 24px;
    color: var(--color-muted-text);
  }

  .location-panel__tag {
    position: absolute;
    right: 24px;
    bottom: 24px;
    padding: 0.55rem 0.85rem;
    background: var(--color-ink);
    color: var(--color-white);
    font-family: var(--font-meta);
    font-size: var(--meta-size);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .location-panel--compact .location-panel__map {
    min-height: 320px;
  }

  @media (max-width: 820px) {
    .location-panel {
      grid-template-columns: 1fr;
    }

    .location-panel__map {
      min-height: 300px;
    }
  }
</style>
