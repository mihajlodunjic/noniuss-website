---
import { business } from "../../data/business";
import SectionLabel from "../layout/SectionLabel.astro";

type Props = {
  number: string;
  label: string;
  title: string;
  text: string;
  address: string;
  primaryCta: string;
  secondaryCta?: string;
  compact?: boolean;
};

const { number, label, title, text, address, primaryCta, secondaryCta, compact = false } =
  Astro.props as Props;
---

<section class="section-shell">
  <div class="container section-grid">
    <SectionLabel number={number} label={label} />

    <div class={`location-panel ${compact ? "location-panel--compact" : ""}`}>
      <div class="location-panel__copy flow-lg">
        <h2>{title}</h2>
        <p>{text}</p>
      </div>

      <aside class="location-panel__ledger" aria-label="Podaci o lokaciji kluba">
        <div class="location-panel__row">
          <span class="meta-text">Lokacija kluba</span>
          <p class="location-panel__place">{business.locationLabel}</p>
        </div>

        <div class="location-panel__row">
          <span class="meta-text">Potvrđena adresa</span>
          <strong>{address}</strong>
        </div>

        <div class="location-panel__row">
          <span class="meta-text">Dolazak</span>
          <p>{business.arrivalNote}</p>
        </div>

        <div class="location-panel__row location-panel__row--actions">
          <div class="location-panel__actions">
            <a
              class="button button--primary"
              href={business.mapUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              {primaryCta}
            </a>
            {secondaryCta && <a class="link-arrow" href={business.phoneUri}>{secondaryCta}</a>}
          </div>
        </div>
      </aside>
    </div>
  </div>
</section>

<style>
  .location-panel {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(280px, 0.95fr);
    gap: clamp(1.5rem, 3vw, 2.75rem);
    align-items: start;
  }

  .location-panel__copy {
    max-width: 38rem;
  }

  .location-panel__ledger {
    display: grid;
    align-self: start;
    border-top: var(--border);
    border-bottom: var(--border);
    background:
      linear-gradient(180deg, rgba(251, 249, 243, 0.72), rgba(243, 239, 228, 0.2)),
      transparent;
  }

  .location-panel__row {
    display: grid;
    gap: 0.45rem;
    padding-block: 1rem;
    border-bottom: var(--border);
  }

  .location-panel__row:last-child {
    border-bottom: 0;
  }

  .location-panel__place {
    font-family: var(--font-display);
    font-size: clamp(1.55rem, 2.5vw, 2.2rem);
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .location-panel__row strong {
    font-size: clamp(1.05rem, 1rem + 0.3vw, 1.2rem);
    line-height: 1.35;
  }

  .location-panel__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    align-items: center;
  }

  .location-panel--compact {
    grid-template-columns: minmax(0, 1.08fr) minmax(260px, 0.82fr);
  }

  @media (max-width: 900px) {
    .location-panel,
    .location-panel--compact {
      grid-template-columns: 1fr;
    }

    .location-panel__copy {
      max-width: 100%;
    }
  }

  @media (max-width: 520px) {
    .location-panel__row {
      padding-block: 0.9rem;
    }

    .location-panel__place {
      font-size: clamp(1.35rem, 8vw, 1.9rem);
    }

    .location-panel__actions {
      align-items: stretch;
    }

    .location-panel__actions .button {
      width: 100%;
    }
  }
</style>
