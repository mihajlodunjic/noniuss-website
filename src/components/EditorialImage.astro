---
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";
import SectionLabel from "./layout/SectionLabel.astro";

type Props = {
  number: string;
  label: string;
  title: string;
  text: string | string[];
  aside?: string;
  image: ImageMetadata;
  alt: string;
  caption?: string;
  reverse?: boolean;
  tone?: "paper" | "sage";
  sizes?: string;
  widths?: number[];
};

const {
  number,
  label,
  title,
  text,
  aside,
  image,
  alt,
  caption,
  reverse = false,
  tone = "paper",
  sizes = "(max-width: 820px) 100vw, 56vw",
  widths = [480, 800, 1280]
} = Astro.props as Props;

const paragraphs = Array.isArray(text) ? text : [text];
---

<section class={`editorial editorial--${tone} section-shell`}>
  <div class="container">
    <div class={`editorial__grid ${reverse ? "editorial__grid--reverse" : ""}`}>
      <SectionLabel number={number} label={label} />

      <figure class="editorial__figure">
        <Picture
          src={image}
          alt={alt}
          formats={["webp"]}
          widths={widths}
          sizes={sizes}
          loading="lazy"
        />
        {caption && <figcaption>{caption}</figcaption>}
      </figure>

      <div class="editorial__content flow-lg">
        <h2>{title}</h2>
        {paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        {aside && <p class="paper-note editorial__aside">{aside}</p>}
        <slot />
      </div>
    </div>
  </div>
</section>

<style>
  .editorial--paper {
    background: var(--color-paper);
  }

  .editorial--sage {
    background: rgba(220, 224, 212, 0.55);
  }

  .editorial__grid {
    display: grid;
    grid-template-columns: minmax(0, 110px) minmax(0, 1.1fr) minmax(0, 0.95fr);
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: center;
  }

  .editorial__grid--reverse .editorial__figure {
    order: 3;
  }

  .editorial__grid--reverse .editorial__content {
    order: 2;
  }

  .editorial__figure {
    margin-right: -6vw;
  }

  .editorial__figure picture {
    overflow: hidden;
  }

  .editorial__figure :global(img) {
    width: 100%;
    height: auto;
    transition: transform 220ms ease;
  }

  .editorial__figure:hover :global(img) {
    transform: scale(1.012);
  }

  .editorial__figure figcaption {
    margin-top: var(--space-3);
    color: var(--color-muted-text);
    font-size: var(--small-size);
  }

  .editorial__content {
    display: grid;
    gap: var(--space-4);
  }

  .editorial__aside {
    max-width: 34ch;
  }

  @media (max-width: 1024px) {
    .editorial__figure {
      margin-right: 0;
    }
  }

  @media (max-width: 820px) {
    .editorial__grid {
      grid-template-columns: 1fr;
    }

    .editorial__grid--reverse .editorial__figure,
    .editorial__grid--reverse .editorial__content {
      order: initial;
    }
  }
</style>
