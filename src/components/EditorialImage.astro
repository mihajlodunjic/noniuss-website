---
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";
import SectionLabel from "./layout/SectionLabel.astro";

type Props = {
  number: string;
  label: string;
  title: string;
  text: string | string[];
  aside?: string;
  image: ImageMetadata;
  alt: string;
  caption?: string;
  reverse?: boolean;
  tone?: "paper" | "sage";
  sizes?: string;
  widths?: number[];
  imageRatio?: string;
  imageRatioMobile?: string;
  imagePosition?: string;
  imageFilter?: string;
  titleMaxWidth?: string;
};

const {
  number,
  label,
  title,
  text,
  aside,
  image,
  alt,
  caption,
  reverse = false,
  tone = "paper",
  sizes = "(max-width: 820px) 100vw, 56vw",
  widths = [480, 800, 1280],
  imageRatio = "4 / 5",
  imageRatioMobile = "4 / 3",
  imagePosition = "center center",
  imageFilter = "var(--image-filter-balanced)",
  titleMaxWidth = "14ch"
} = Astro.props as Props;

const paragraphs = Array.isArray(text) ? text : [text];
const sectionStyle = [
  `--editorial-ratio:${imageRatio}`,
  `--editorial-ratio-mobile:${imageRatioMobile}`,
  `--editorial-image-position:${imagePosition}`,
  `--editorial-image-filter:${imageFilter}`,
  `--editorial-title-max:${titleMaxWidth}`
].join(";");
---

<section class={`editorial editorial--${tone} section-shell`} style={sectionStyle}>
  <div class="container">
    <div class={`editorial__grid ${reverse ? "editorial__grid--reverse" : ""}`}>
      <SectionLabel number={number} label={label} />

      <figure class="editorial__figure">
        <Picture
          src={image}
          alt={alt}
          formats={["webp"]}
          widths={widths}
          sizes={sizes}
          loading="lazy"
        />
        {caption && <figcaption>{caption}</figcaption>}
      </figure>

      <div class="editorial__content flow-lg">
        <h2>{title}</h2>
        {paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        {aside && <p class="paper-note editorial__aside">{aside}</p>}
        <slot />
      </div>
    </div>
  </div>
</section>

<style>
  .editorial--paper {
    background: var(--color-paper);
  }

  .editorial--sage {
    background: rgba(220, 224, 212, 0.55);
  }

  .editorial__grid {
    display: grid;
    grid-template-columns: minmax(0, 110px) minmax(0, 1.1fr) minmax(0, 0.95fr);
    gap: clamp(1.25rem, 3vw, 2.5rem);
    align-items: start;
  }

  .editorial__grid--reverse .editorial__figure {
    order: 3;
  }

  .editorial__grid--reverse .editorial__content {
    order: 2;
  }

  .editorial__figure {
    margin-right: clamp(-3rem, -2vw, 0rem);
    border-radius: var(--radius-lg);
    background: rgba(220, 224, 212, 0.58);
    overflow: hidden;
  }

  .editorial__figure picture {
    display: block;
    aspect-ratio: var(--editorial-ratio);
  }

  .editorial__figure :global(img) {
    width: 100%;
    height: 100%;
    aspect-ratio: var(--editorial-ratio);
    object-fit: cover;
    object-position: var(--editorial-image-position);
    filter: var(--editorial-image-filter);
    transition: transform 220ms ease;
  }

  .editorial__figure:hover :global(img) {
    transform: scale(1.012);
  }

  .editorial__figure figcaption {
    margin-top: var(--space-3);
    color: var(--color-muted-text);
    font-size: var(--small-size);
  }

  .editorial__content {
    display: grid;
    gap: var(--space-4);
  }

  .editorial__content h2 {
    max-width: var(--editorial-title-max);
  }

  .editorial__aside {
    max-width: 34ch;
  }

  .editorial__grid--reverse .editorial__figure {
    margin-right: 0;
    margin-left: clamp(-3rem, -2vw, 0rem);
  }

  @media (max-width: 1024px) {
    .editorial__figure,
    .editorial__grid--reverse .editorial__figure {
      margin-inline: 0;
    }
  }

  @media (max-width: 820px) {
    .editorial__grid {
      grid-template-columns: 1fr;
    }

    .editorial__grid--reverse .editorial__figure,
    .editorial__grid--reverse .editorial__content {
      order: initial;
    }

    .editorial__figure picture,
    .editorial__figure :global(img) {
      aspect-ratio: var(--editorial-ratio-mobile);
    }
  }
</style>
