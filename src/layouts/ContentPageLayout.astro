---
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import SectionLabel from "../components/layout/SectionLabel.astro";

type Breadcrumb = {
  name: string;
  href: string;
};

type Props = {
  number: string;
  label: string;
  eyebrow: string;
  title: string;
  intro: string;
  ctaLabel: string;
  ctaHref: string;
  breadcrumbs: Breadcrumb[];
  secondaryCtaLabel?: string;
  secondaryCtaHref?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  tone?: "paper" | "ink" | "sage";
  asideLines?: string[];
  titleMaxWidth?: string;
  introMaxWidth?: string;
  imageRatio?: string;
  imageRatioMobile?: string;
  imagePosition?: string;
  imageFilter?: string;
};

const {
  number,
  label,
  eyebrow,
  title,
  intro,
  ctaLabel,
  ctaHref,
  breadcrumbs,
  secondaryCtaLabel,
  secondaryCtaHref,
  image,
  imageAlt,
  tone = "paper",
  asideLines = [],
  titleMaxWidth = "11ch",
  introMaxWidth = "35rem",
  imageRatio = "16 / 11",
  imageRatioMobile = "4 / 3",
  imagePosition = "center 50%",
  imageFilter = "var(--image-filter-balanced)"
} = Astro.props as Props;

const heroStyle = [
  `--content-page-title-max:${titleMaxWidth}`,
  `--content-page-intro-max:${introMaxWidth}`,
  `--content-page-figure-ratio:${imageRatio}`,
  `--content-page-figure-ratio-mobile:${imageRatioMobile}`,
  `--content-page-image-position:${imagePosition}`,
  `--content-page-image-filter:${imageFilter}`
].join(";");
---

<section class={`content-page-hero content-page-hero--${tone}`} style={heroStyle}>
  <div class="container content-page-hero__inner">
    <SectionLabel number={number} label={label} />

    <div class="content-page-hero__content flow-lg">
      <Breadcrumbs items={breadcrumbs} />
      <span class="eyebrow-stack eyebrow">{eyebrow}</span>
      <h1>{title}</h1>
      <p class="lead">{intro}</p>
      <div class="content-page-hero__actions">
        <a class="button button--primary" href={ctaHref}>{ctaLabel}</a>
        {secondaryCtaLabel && secondaryCtaHref && (
          <a class="link-arrow" href={secondaryCtaHref}>{secondaryCtaLabel}</a>
        )}
      </div>
    </div>

    {image ? (
      <figure class="content-page-hero__figure">
        <Picture
          src={image}
          alt={imageAlt || ""}
          formats={["webp"]}
          widths={[560, 960, 1440]}
          sizes="(max-width: 860px) 100vw, 52vw"
          loading="eager"
          priority
        />
      </figure>
    ) : (
      <aside class="content-page-hero__aside">
        <span class="meta-text">Pre dolaska</span>
        <ul>
          {asideLines.map((line) => (
            <li>{line}</li>
          ))}
        </ul>
      </aside>
    )}
  </div>
</section>

<style>
  .content-page-hero {
    padding-block: clamp(1.35rem, 4vw, 2.5rem) clamp(3rem, 6vw, 4.8rem);
  }

  .content-page-hero--paper {
    background: var(--color-paper);
  }

  .content-page-hero--ink {
    background: var(--color-ink);
    color: var(--color-white);
  }

  .content-page-hero--sage {
    background: rgba(220, 224, 212, 0.55);
  }

  .content-page-hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 92px) minmax(0, 0.98fr) minmax(0, 1.02fr);
    gap: clamp(1.25rem, 3vw, 2.5rem);
    align-items: start;
  }

  .content-page-hero__content {
    max-width: min(100%, 46rem);
    padding-top: clamp(0.15rem, 1vw, 0.75rem);
  }

  .content-page-hero__content h1 {
    max-width: var(--content-page-title-max);
    font-size: clamp(3.3rem, 4.3vw, 4.85rem);
    line-height: 0.98;
  }

  .content-page-hero__content .lead {
    max-width: var(--content-page-intro-max);
  }

  .content-page-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 1.25rem;
    align-items: center;
  }

  .content-page-hero__figure {
    overflow: hidden;
    border: var(--border);
    border-radius: var(--radius-lg);
    background: rgba(220, 224, 212, 0.6);
  }

  .content-page-hero__figure :global(picture) {
    display: block;
    aspect-ratio: var(--content-page-figure-ratio);
  }

  .content-page-hero__figure :global(img) {
    width: 100%;
    height: 100%;
    aspect-ratio: var(--content-page-figure-ratio);
    object-fit: cover;
    object-position: var(--content-page-image-position);
    filter: var(--content-page-image-filter);
  }

  .content-page-hero__aside {
    display: grid;
    gap: var(--space-3);
    padding: clamp(1.15rem, 2.4vw, 1.8rem);
    border: var(--border);
    border-radius: var(--radius-md);
    background: rgba(251, 249, 243, 0.92);
    color: var(--color-ink);
    align-self: start;
  }

  .content-page-hero__aside ul {
    display: grid;
    gap: 0.85rem;
  }

  .content-page-hero__aside li {
    padding-bottom: 0.85rem;
    border-bottom: var(--border);
  }

  @media (max-width: 880px) {
    .content-page-hero__inner {
      grid-template-columns: 1fr;
    }

    .content-page-hero__content {
      max-width: 100%;
      padding-top: 0;
    }

    .content-page-hero__content h1 {
      max-width: 11.5ch;
      font-size: var(--h1-size);
    }

    .content-page-hero__figure :global(picture),
    .content-page-hero__figure :global(img) {
      aspect-ratio: var(--content-page-figure-ratio-mobile);
    }
  }
</style>
