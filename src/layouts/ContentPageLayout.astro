---
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import SectionLabel from "../components/layout/SectionLabel.astro";

type Breadcrumb = {
  name: string;
  href: string;
};

type Props = {
  number: string;
  label: string;
  eyebrow: string;
  title: string;
  intro: string;
  ctaLabel: string;
  ctaHref: string;
  breadcrumbs: Breadcrumb[];
  secondaryCtaLabel?: string;
  secondaryCtaHref?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  tone?: "paper" | "ink" | "sage";
  asideLines?: string[];
};

const {
  number,
  label,
  eyebrow,
  title,
  intro,
  ctaLabel,
  ctaHref,
  breadcrumbs,
  secondaryCtaLabel,
  secondaryCtaHref,
  image,
  imageAlt,
  tone = "paper",
  asideLines = []
} = Astro.props as Props;
---

<section class={`content-page-hero content-page-hero--${tone}`}>
  <div class="container content-page-hero__inner">
    <SectionLabel number={number} label={label} />

    <div class="content-page-hero__content flow-lg">
      <Breadcrumbs items={breadcrumbs} />
      <span class="eyebrow-stack eyebrow">{eyebrow}</span>
      <h1>{title}</h1>
      <p class="lead">{intro}</p>
      <div class="content-page-hero__actions">
        <a class="button button--primary" href={ctaHref}>{ctaLabel}</a>
        {secondaryCtaLabel && secondaryCtaHref && (
          <a class="link-arrow" href={secondaryCtaHref}>{secondaryCtaLabel}</a>
        )}
      </div>
    </div>

    {image ? (
      <figure class="content-page-hero__figure">
        <Picture
          src={image}
          alt={imageAlt || ""}
          formats={["webp"]}
          widths={[560, 960, 1440]}
          sizes="(max-width: 860px) 100vw, 52vw"
          loading="eager"
          priority
        />
      </figure>
    ) : (
      <aside class="content-page-hero__aside">
        <span class="meta-text">Pre dolaska</span>
        <ul>
          {asideLines.map((line) => (
            <li>{line}</li>
          ))}
        </ul>
      </aside>
    )}
  </div>
</section>

<style>
  .content-page-hero {
    padding-block: clamp(2rem, 6vw, 4rem) clamp(4rem, 8vw, 6rem);
  }

  .content-page-hero--paper {
    background: var(--color-paper);
  }

  .content-page-hero--ink {
    background: var(--color-ink);
    color: var(--color-white);
  }

  .content-page-hero--sage {
    background: rgba(220, 224, 212, 0.55);
  }

  .content-page-hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 110px) minmax(0, 0.88fr) minmax(0, 1.12fr);
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: center;
  }

  .content-page-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    align-items: center;
  }

  .content-page-hero__figure {
    overflow: hidden;
    border: var(--border);
  }

  .content-page-hero__figure :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 11;
    object-fit: cover;
  }

  .content-page-hero__aside {
    display: grid;
    gap: var(--space-4);
    padding: clamp(1.25rem, 3vw, 2rem);
    border: var(--border);
    background: rgba(251, 249, 243, 0.92);
    color: var(--color-ink);
  }

  .content-page-hero__aside ul {
    display: grid;
    gap: var(--space-3);
  }

  .content-page-hero__aside li {
    padding-bottom: var(--space-3);
    border-bottom: var(--border);
  }

  @media (max-width: 860px) {
    .content-page-hero__inner {
      grid-template-columns: 1fr;
    }
  }
</style>
